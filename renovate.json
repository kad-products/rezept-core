{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"minimumReleaseAge": "3 days",
	"labels": ["dependencies"],
	"packageRules": [
		{
			"description": "Group and automerge non-major dependency updates. CI must pass before merge.",
			"matchDepTypes": ["devDependencies", "dependencies"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "dependency (non-major)",
			"automerge": true,
			"automergeType": "pr",
			"platformAutomerge": true
		},
		{
			"description": "Automerge Node.js patch/minor updates. Node is managed via .nvmrc (nodenv manager), not package.json, so matchDepTypes does not apply.",
			"matchPackageNames": ["node"],
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true,
			"automergeType": "pr",
			"platformAutomerge": true
		},
		{
			"description": "Automerge GitHub Actions patch/minor updates. Actions use the github-actions manager, not package.json depTypes.",
			"matchManagers": ["github-actions"],
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true,
			"automergeType": "pr",
			"platformAutomerge": true
		},
		{
			"description": "Group Drizzle packages together. No automerge — migrations may be needed.",
			"matchPackageNames": ["drizzle-orm", "drizzle-kit", "drizzle-zod", "drizzle-seed", "drizzle-mermaid-generator"],
			"groupName": "Drizzle",
			"automerge": false
		},
		{
			"description": "Group Cloudflare packages together. No automerge — wrangler and worker types often have behaviour changes.",
			"matchPackageNames": ["wrangler", "@cloudflare/workers-types", "@cloudflare/vite-plugin"],
			"groupName": "Cloudflare",
			"automerge": false
		},
		{
			"description": "Group RedwoodSDK packages together.",
			"matchPackageNames": ["rwsdk"],
			"groupName": "RedwoodSDK",
			"automerge": false
		}
	]
}
