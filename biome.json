{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 130
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noConsole": "error"
			},
			"nursery": {
				"useExplicitType": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "asNeeded"
		}
	},
	"css": {
		"formatter": {
			"enabled": true,
			"indentStyle": "tab"
		}
	},
	"files": {
		"includes": [
			"**",
			"!.claude",
			"!coverage",
			"!worker-configuration.d.ts",
			"!**/.terraform",
			"!**/node_modules",
			"!**/dist",
			"!**/.wrangler",
			"!**/bundle-stats*.html",
			"!playwright-report",
			"!test-results",
			"!playwright/.cache",
			"!storybook-static",
			"!tests"
		]
	},
	"overrides": [
		{
			"includes": [
				"**/__tests__/**",
				"tests/**",
				"scripts/**",
				"src/models/**",
				"src/schemas/**",
				".storybook/**",
				"**/*.stories.tsx",
				"**/*.test.tsx"
			],
			"linter": {
				"rules": {
					"nursery": {
						"useExplicitType": "off"
					},
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			"includes": ["src/components/**", "src/forms/**", "src/layouts/**", "src/pages/**", "scripts/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	]
}
