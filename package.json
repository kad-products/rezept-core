{
	"name": "@kad-products/rezept-core",
	"version": "1.74.0",
	"private": true,
	"description": "Seasonal ingredients and recipes made easy.",
	"keywords": [],
	"license": "MIT",
	"author": "",
	"type": "module",
	"main": "src/worker.tsx",
	"scripts": {
		"biome:check": "biome check",
		"biome:fix": "biome check --write .",
		"build": "vite build",
		"clean": "npm run clean:vite",
		"clean:vite": "rm -rf ./node_modules/.vite",
		"db:load": "tsx scripts/db-load.ts",
		"db:migrate:dev": "wrangler d1 migrations apply REZEPT_CORE --local",
		"db:migrate:generate": "drizzle-kit generate",
		"db:migrate:prod": "wrangler d1 migrations apply rezept_core --remote",
		"db:reset-local": "tsx scripts/db-reset.ts",
		"db:seed": "tsx scripts/seeding/main.ts",
		"dev": "npm run clean:vite && vite dev",
		"dev:init": "rw-scripts dev-init",
		"docs:generate": "tsx scripts/docs/main.ts",
		"erd:generate": "drizzle-mermaid-generator --dialect sqlite --schema ./src/models/index.ts --relational > docs/data/current-erd.mmd",
		"erd:render": "npx -p @mermaid-js/mermaid-cli mmdc -i docs/data/current-erd.mmd -o docs/data/current-erd.png -t forest -w 3000 -H 2000",
		"generate": "rw-scripts ensure-env && wrangler types --include-runtime false && tsx scripts/fix-env-types.ts",
		"playwright-ct:run": "playwright test -c playwright-ct.config.ts",
		"playwright-ct:ui": "playwright test -c playwright-ct.config.ts --ui",
		"playwright-ct:update": "playwright test -c playwright-ct.config.ts --update-snapshots",
		"playwright-e2e:run": "playwright test -c playwright.config.ts",
		"playwright-e2e:ui": "playwright test -c playwright.config.ts --ui",
		"prepare": "husky",
		"preview": "vite preview",
		"release": "rw-scripts ensure-deploy-env && npm run clean && vite build --mode $CLOUDFLARE_ENV && wrangler d1 migrations apply REZEPT_CORE --remote --env $CLOUDFLARE_ENV && wrangler deploy --env $CLOUDFLARE_ENV",
		"storybook:build": "storybook build",
		"storybook:dev": "storybook dev -p 6006",
		"test": "vitest",
		"test:run": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:workers": "vitest --config vitest.workers.config.ts",
		"test:workers:run": "vitest run --config vitest.workers.config.ts",
		"type-check": "tsc",
		"worker:run": "rw-scripts worker-run"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		],
		"package.json": [
			"prettier --write"
		],
		"*.{css,less}": [
			"prettier --write"
		],
		"worker-configuration.d.ts": []
	},
	"dependencies": {
		"@jlucaspains/sharp-recipe-parser": "^1.3.6",
		"@radix-ui/colors": "^3.0.0",
		"@radix-ui/react-icons": "^1.3.2",
		"@simplewebauthn/browser": "^13.2.2",
		"@simplewebauthn/server": "^13.2.2",
		"@tanstack/react-form": "^1.28.0",
		"chalk": "^5.6.2",
		"classnames": "^2.5.1",
		"drizzle-orm": "^0.45.1",
		"i18n-iso-countries": "^7.14.0",
		"js-yaml": "^5.2.1",
		"object-path": "^0.11.8",
		"parse-ingredient": "^2.2.0",
		"radix-ui": "^1.4.3",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-server-dom-webpack": "19.2.7",
		"rwsdk": "1.5.3",
		"ua-parser-js": "^2.0.8",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@cloudflare/vite-plugin": "1.42.3",
		"@cloudflare/vitest-pool-workers": "^0.18.0",
		"@cloudflare/workers-types": "^4.20260629.1",
		"@commitlint/cli": "^21.0.0",
		"@commitlint/config-conventional": "^21.0.0",
		"@faker-js/faker": "^10.1.0",
		"@libsql/client": "^0.17.0",
		"@playwright/experimental-ct-react": "^1.60.0",
		"@playwright/test": "^1.60.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/release-notes-generator": "^14.1.0",
		"@storybook/react": "^10.4.1",
		"@storybook/react-vite": "^10.4.1",
		"@storybook/test": "^8.6.15",
		"@tanstack/react-devtools": "^0.10.0",
		"@tanstack/react-form-devtools": "^0.2.13",
		"@types/better-sqlite3": "^7.6.13",
		"@types/jsdom": "^28.0.3",
		"@types/node": "~26.1.0",
		"@types/object-path": "^0.11.4",
		"@types/papaparse": "^5.5.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.1.2",
		"@vitest/coverage-v8": "^4.1.5",
		"@vitest/ui": "^4.1.5",
		"chalk-template": "^1.1.2",
		"change-case": "^5.4.4",
		"conventional-changelog-conventionalcommits": "^9.1.0",
		"drizzle-kit": "^0.31.8",
		"drizzle-mermaid-generator": "^0.0.5",
		"drizzle-seed": "^0.3.1",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"less": "^4.3.0",
		"lint-staged": "^17.0.0",
		"papaparse": "^5.5.3",
		"prettier": "^3.8.2",
		"prettier-plugin-packagejson": "^3.0.2",
		"rollup-plugin-visualizer": "^7.0.1",
		"rwsdk-community": "^0.1.2",
		"storybook": "^10.4.1",
		"tsx": "^4.21.0",
		"typescript": "6.0.3",
		"vite": "8.1.4",
		"vitest": "^4.1.5",
		"wrangler": "4.105.0"
	},
	"packageManager": "pnpm@11.5.1"
}
