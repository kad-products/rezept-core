{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rezept",
	"main": "src/worker.tsx",
	"compatibility_date": "2025-08-21",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"WEBAUTHN_APP_NAME": "rezept",
		"REZEPT_ENV": "development",
		"LOG_LEVEL": "debug",
		"LOG_LEVEL_TASK_OVERRIDE": ""
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SessionDurableObject"]
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "AED_LOGIN_ATTEMPTS",
			"dataset": "login_attempts_local"
		},
		{
			"binding": "AED_API_KEY_USED",
			"dataset": "api_key_used_local"
		},
		{
			"binding": "AED_SCRAPE_ATTEMPTS",
			"dataset": "scrape_attempts_local"
		}
	],
	// Top-level bindings used by wrangler dev (local/miniflare)
	"durable_objects": {
		"bindings": [
			{
				"name": "SESSION_DURABLE_OBJECT",
				"class_name": "SessionDurableObject"
			}
		]
	},
	"d1_databases": [
		{
			"binding": "REZEPT_CORE",
			"database_name": "rezept-core-local",
			"database_id": "local",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "REZEPT_RECIPE_UPLOADS",
			"bucket_name": "rezept-recipe-uploads-local"
		},
		{
			"binding": "REZEPT_RECIPE_SCRAPES",
			"bucket_name": "rezept-recipe-scrapes-local"
		},
		{
			"binding": "REZEPT_IMAGES",
			"bucket_name": "rezept-images-local"
		},
		{
			"binding": "REZEPT_ADMIN_OPERATIONS",
			"bucket_name": "rezept-admin-operations-local"
		}
	],
	"workflows": [
		{
			"name": "recipe-ingredients-linked-to-ingredients-workflow",
			"binding": "RECIPE_INGREDIENTS_LINKED_TO_INGREDIENTS_WORKFLOW",
			"class_name": "RecipeIngredientsLinkedToIngredientsWorkflow"
		},
		{
			"name": "recipe-raw-ingredients-to-ingredients-workflow",
			"binding": "RECIPE_RAW_INGREDIENTS_TO_INGREDIENTS_WORKFLOW",
			"class_name": "RecipeRawIngredientsToIngredientsWorkflow"
		},
		{
			"name": "recipe-scrape-cover-image-retry-workflow",
			"binding": "RECIPE_SCRAPE_COVER_IMAGE_RETRY_WORKFLOW",
			"class_name": "RecipeScrapeCoverImageRetryWorkflow"
		}
	],
	"env": {
		"integration": {
			"d1_databases": [
				{
					"binding": "REZEPT_CORE",
					"database_id": "1ea3d2e0-e4fe-4cd6-8469-2ab23bd51558",
					"database_name": "rezept-core-integration",
					"migrations_dir": "drizzle"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"class_name": "SessionDurableObject",
						"name": "SESSION_DURABLE_OBJECT"
					}
				]
			},
			"r2_buckets": [
				{
					"binding": "REZEPT_RECIPE_UPLOADS",
					"bucket_name": "rezept-recipe-uploads-integration"
				},
				{
					"binding": "REZEPT_RECIPE_SCRAPES",
					"bucket_name": "rezept-recipe-scrapes-integration"
				},
				{
					"binding": "REZEPT_IMAGES",
					"bucket_name": "rezept-images-integration"
				},
				{
					"binding": "REZEPT_ADMIN_OPERATIONS",
					"bucket_name": "rezept-admin-operations-integration"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "AED_LOGIN_ATTEMPTS",
					"dataset": "login_attempts_integration"
				},
				{
					"binding": "AED_API_KEY_USED",
					"dataset": "api_key_used_integration"
				},
				{
					"binding": "AED_SCRAPE_ATTEMPTS",
					"dataset": "scrape_attempts_integration"
				}
			],
			"workflows": [
				{
					"name": "recipe-scrape-cover-image-retry-workflow",
					"binding": "RECIPE_SCRAPE_COVER_IMAGE_RETRY_WORKFLOW",
					"class_name": "RecipeScrapeCoverImageRetryWorkflow"
				}
			],
			"vars": {
				"WEBAUTHN_APP_NAME": "rezept",
				"REZEPT_ENV": "integration",
				"LOG_LEVEL": "info",
				"LOG_LEVEL_TASK_OVERRIDE": ""
			},
			"workers_dev": true
		},
		"staging": {
			"d1_databases": [
				{
					"binding": "REZEPT_CORE",
					"database_id": "8ef40bea-0c58-43b3-a1f0-7ebecd3ee11d",
					"database_name": "rezept-core-staging",
					"migrations_dir": "drizzle"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"class_name": "SessionDurableObject",
						"name": "SESSION_DURABLE_OBJECT"
					}
				]
			},
			"r2_buckets": [
				{
					"binding": "REZEPT_RECIPE_UPLOADS",
					"bucket_name": "rezept-recipe-uploads-staging"
				},
				{
					"binding": "REZEPT_RECIPE_SCRAPES",
					"bucket_name": "rezept-recipe-scrapes-staging"
				},
				{
					"binding": "REZEPT_IMAGES",
					"bucket_name": "rezept-images-staging"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "AED_LOGIN_ATTEMPTS",
					"dataset": "login_attempts_staging"
				},
				{
					"binding": "AED_API_KEY_USED",
					"dataset": "api_key_used_staging"
				},
				{
					"binding": "AED_SCRAPE_ATTEMPTS",
					"dataset": "scrape_attempts_staging"
				}
			],
			"workflows": [
				{
					"name": "recipe-scrape-cover-image-retry-workflow",
					"binding": "RECIPE_SCRAPE_COVER_IMAGE_RETRY_WORKFLOW",
					"class_name": "RecipeScrapeCoverImageRetryWorkflow"
				}
			],
			"vars": {
				"WEBAUTHN_APP_NAME": "rezept",
				"REZEPT_ENV": "staging",
				"LOG_LEVEL": "info",
				"LOG_LEVEL_TASK_OVERRIDE": ""
			},
			"workers_dev": true
		},
		"production": {
			"routes": [
				{
					"pattern": "kad-rezept.com",
					"custom_domain": true
				},
				{
					"pattern": "www.kad-rezept.com",
					"custom_domain": true
				}
			],
			"d1_databases": [
				{
					"binding": "REZEPT_CORE",
					"database_id": "ff54cd4d-0099-4cb5-90e9-b9a2d8d6121e",
					"database_name": "rezept-core-production",
					"migrations_dir": "drizzle"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"class_name": "SessionDurableObject",
						"name": "SESSION_DURABLE_OBJECT"
					}
				]
			},
			"r2_buckets": [
				{
					"binding": "REZEPT_RECIPE_UPLOADS",
					"bucket_name": "rezept-recipe-uploads-production"
				},
				{
					"binding": "REZEPT_RECIPE_SCRAPES",
					"bucket_name": "rezept-recipe-scrapes-production"
				},
				{
					"binding": "REZEPT_IMAGES",
					"bucket_name": "rezept-images-production"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "AED_LOGIN_ATTEMPTS",
					"dataset": "login_attempts_production"
				},
				{
					"binding": "AED_API_KEY_USED",
					"dataset": "api_key_used_production"
				},
				{
					"binding": "AED_SCRAPE_ATTEMPTS",
					"dataset": "scrape_attempts_production"
				}
			],
			"workflows": [
				{
					"name": "recipe-scrape-cover-image-retry-workflow",
					"binding": "RECIPE_SCRAPE_COVER_IMAGE_RETRY_WORKFLOW",
					"class_name": "RecipeScrapeCoverImageRetryWorkflow"
				}
			],
			"vars": {
				"WEBAUTHN_APP_NAME": "rezept",
				"REZEPT_ENV": "production",
				"LOG_LEVEL": "info",
				"LOG_LEVEL_TASK_OVERRIDE": ""
			},
			"workers_dev": false
		}
	}
}
